## Ignore Visual Studio temporary files, build outputs and user-specific files

# Visual Studio folder
.vs/

# User-specific files
*.suo
*.user
*.vcxproj.user
*.userosscache

# Visual C++ database
*.sdf
*.VC.db
*.VC.opendb

# Build folders
Debug/
Release/
x64/
build/

# Compiled object files, libraries, executables, and debug files
*.obj
*.o
*.lib
*.dll
*.exe
*.pdb
*.ilk

# VS intermediate files
*.ipch
*.iobj
*.idb

# Logs and archives
*.log
*.zip
*.7z

# Ignore other editor/OS files
*.DS_Store
Thumbs.db

# Keep source files and project files tracked (no negations needed)
export/*.js
